# Ignore everything by default
*

# Except these top-level files
!.gitignore
!README.md
!start_qemu.sh

# Allow new directory structure
!drivers/
!drivers/*.c
!drivers/Makefile

!tests/
!tests/*/
!tests/*/*.c
!tests/*/*.cpp
!tests/*/*.py
!tests/*/*.sh

!utils/
!utils/*.py
!utils/*.sh

!examples/
!examples/*.c
!examples/*.cpp

# Ignore build artifacts everywhere
*.o
*.ko
*.mod.c
*.symvers
*.order
*.cmd
